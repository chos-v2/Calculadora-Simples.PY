while True:
    try:
        operadores = ("+", "-", "/", "*")
        num1 = float(input("Digite um valor: "))
        num2 = float(input("Digite outro valor: "))
    except ValueError:
        print("Entrada inválida, digite apenas números")
        continue
    while True:
        opr = input("Escolha um operador: ( + ) ( - ) ( / ) ( * )")
        if opr in operadores:
            break
        print("ERRO: Operador inválido, tente novamente ")

    if opr == "+":
        print("-" *30)
        print(f"Resultado: {num1 + num2}")
        print("-" *30)


    elif opr == "-":
        print("-" *30)
        print(f"Resultado: {num1 - num2}")
        print("-" *30)

    elif opr == "/":
        if num2 == 0:
            print("Não é possivel dividir por 0!")
        else:
            print("-" *30)
            print(f"Resultado: {num1 / num2}")
            print("-" *30)


    elif opr == "*":
        print("-" *30)
        print(f"Resultado: {num1 * num2}")
        print("-" *30)

    operadores = ("+" "-" "/" "*")


    while True:
        continuar = input("Deseja realizar um novo cálculo?: S / N").lower()
        if continuar == "n":
            print("Fim do programa")
            exit()
        elif continuar == "s":
            break
        else:
            print("Escolha S para sim ou N para não")
